<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+). Nothing leaves the device: not to Google backup, not in a phone-to-phone
    transfer. Entries live in Firestore and come back on sign-in. What's on disk is the Firestore offline
    cache, the Firebase sign-in, and device_prefs (app lock, AI consent, coach chat, push endpoint), and
    none of it should reach another phone. allowBackup="false" alone doesn't stop device transfer, so
    every domain is excluded here as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
