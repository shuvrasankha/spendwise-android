<?xml version="1.0" encoding="utf-8"?>
<!-- An app icon the user can pick in Settings › App icon (AppIcon.kt) -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background_orange" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_dark" />
    <!-- Themed icons (Android 13+) only use the mark's shape, so they look the same whichever icon is picked -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
