<?xml version="1.0" encoding="utf-8"?>
<!-- @android:id/background lets Android 12+ clip the widget to the launcher's corner radius -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/widget_today"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:text="—"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_description"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_add_background"
        android:contentDescription="@string/widget_add"
        android:padding="12dp"
        android:src="@drawable/ic_tab_add"
        android:tint="@color/widget_on_accent" />
</LinearLayout>
