<?xml version="1.0" encoding="utf-8"?>
<!-- The budget in the 4x2 and 4x4 widgets: the bar, the amount left, and the status in words -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Decorative: the line below says the same in words. Two bars, so over budget is red without tinting in code -->
    <ProgressBar
        android:id="@+id/month_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:importantForAccessibility="no"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar_accent" />
    <ProgressBar
        android:id="@+id/month_bar_over"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:importantForAccessibility="no"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar_negative"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/month_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/month_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/widget_month_description"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/month_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_positive"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
